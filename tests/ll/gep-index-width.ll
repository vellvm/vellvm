; getelementptr with index types of every width.
;
; LangRef: "When indexing into an array, pointer or vector, integers of any
; width are allowed ... These integers are treated as signed values where
; relevant", and "If the offsets have a different width from the pointer's
; index type, they are sign-extended or truncated to the width of the
; pointer's index type."  So with a 64-bit index type:
;
; - a narrow index is sign-extended: `i1 true` and `i2 -1` step back one
;   element;
; - an i128 index is truncated: 2^64 + 3 steps forward three elements;
; - with nusw (or inbounds) the truncation must preserve the signed value
;   and with nuw the unsigned value, or the result is poison.
;
; Each function steps from the middle of an array of i32 and returns the
; distance moved, in bytes.
;
; `./a.out N` runs case N natively; `llubi --entry-function=ub_case_N`
; reports poison.  The tail is generated by tests/gen.py --dispatch.

; ------------------------------------------------ narrow indices: sign-extended

define i64 @gep_i1(i1 %i) {
  %a = alloca [64 x i32]
  %base = getelementptr [64 x i32], ptr %a, i64 0, i64 32
  %p = getelementptr i32, ptr %base, i1 %i
  %pi = ptrtoint ptr %p to i64
  %bi = ptrtoint ptr %base to i64
  %d = sub i64 %pi, %bi
  ret i64 %d
}
