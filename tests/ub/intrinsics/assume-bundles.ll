; UB tests for `llvm.assume` operand bundles.
;
; LangRef (Assume Operand Bundles): "Operand bundles on an llvm.assume allows
; representing assumptions ... If the provided guarantees are violated at
; runtime the behavior is undefined."  E.g. `"nonnull"(ptr %p)`,
; `"align"(ptr %p, i64 8)`, `"dereferenceable"(ptr %p, i64 4)`.

declare void @llvm.assume(i1 noundef)

define i32 @assume_nonnull(ptr %p) {
  call void @llvm.assume(i1 true) [ "nonnull"(ptr %p) ] ; <- UB @assume_nonnull
  ret i32 0
}

; ASSERT UB 11: call i32 @assume_nonnull(ptr null)

define i32 @assume_nonnull_ok() {
  %a = alloca i32
  %r = call i32 @assume_nonnull(ptr %a)
  ret i32 %r
}

; ASSERT EQ: i32 0 = call i32 @assume_nonnull_ok()

define i32 @assume_align() {
  %a = alloca [2 x i64], align 8
  %q = getelementptr i8, ptr %a, i64 4
  call void @llvm.assume(i1 true) [ "align"(ptr %q, i64 8) ] ; <- UB @assume_align
  ret i32 0
}

; ASSERT UB 28: call i32 @assume_align()

define i32 @assume_deref() {
  %a = alloca i16
  call void @llvm.assume(i1 true) [ "dereferenceable"(ptr %a, i64 4) ] ; <- UB @assume_deref
  ret i32 0
}

; ASSERT UB 36: call i32 @assume_deref()

define i32 @assume_noundef(i32 %x) {
  call void @llvm.assume(i1 true) [ "noundef"(i32 %x) ] ; <- UB @assume_noundef
  ret i32 0
}

; ASSERT UB 43: call i32 @assume_noundef(i32 poison)
; ASSERT EQ: i32 0 = call i32 @assume_noundef(i32 7)

; "align"(ptr %p, i64 %align, i64 %offset): %p - %offset is aligned.
define i32 @assume_align_offset_ok() {
  %a = alloca [2 x i64], align 8
  %q = getelementptr i8, ptr %a, i64 4
  call void @llvm.assume(i1 true) [ "align"(ptr %q, i64 8, i64 4) ]
  ret i32 0
}

; ASSERT EQ: i32 0 = call i32 @assume_align_offset_ok()

; "If %align is not a power of two, the pointer value must be all-zero."
define i32 @assume_align_npot(ptr %p) {
  call void @llvm.assume(i1 true) [ "align"(ptr %p, i64 3) ] ; <- UB @assume_align_npot_nonnull
  ret i32 0
}

; ASSERT EQ: i32 0 = call i32 @assume_align_npot(ptr null)

define i32 @assume_align_npot_nonnull() {
  %a = alloca i32
  %r = call i32 @assume_align_npot(ptr %a)
  ret i32 %r
}

; ASSERT UB 62: call i32 @assume_align_npot_nonnull()

define i32 @assume_deref_ok() {
  %a = alloca i32
  call void @llvm.assume(i1 true) [ "dereferenceable"(ptr %a, i64 4) ]
  ret i32 0
}

; ASSERT EQ: i32 0 = call i32 @assume_deref_ok()

; "%size may also be zero, in which case the bundle doesn't imply nonnull".
define i32 @assume_deref_zero_null() {
  call void @llvm.assume(i1 true) [ "dereferenceable"(ptr null, i64 0) ]
  ret i32 0
}

; ASSERT EQ: i32 0 = call i32 @assume_deref_zero_null()

define i32 @assume_deref_or_null(ptr %p) {
  call void @llvm.assume(i1 true) [ "dereferenceable_or_null"(ptr %p, i64 4) ] ; <- UB @assume_deref_or_null_small
  ret i32 0
}

; ASSERT EQ: i32 0 = call i32 @assume_deref_or_null(ptr null)

define i32 @assume_deref_or_null_small() {
  %a = alloca i16
  %r = call i32 @assume_deref_or_null(ptr %a)
  ret i32 %r
}

; ASSERT UB 93: call i32 @assume_deref_or_null_small()

