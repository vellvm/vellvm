; `main N` runs case N alone, so UB in one case cannot mask another;
; @ub_case_N is an argument-free entry point for the same call.

; case 0 (line 27): ASSERT UB 17: call i32 @call_nofreeobj_frees_other()
define i32 @ub_case_0() {
  %r = call i32 @call_nofreeobj_frees_other()
  ret i32 %r
}

; case 1 (line 40): ASSERT UB 36: call i32 @free_nofreeobj_return()
define i32 @ub_case_1() {
  %r = call i32 @free_nofreeobj_return()
  ret i32 %r
}

