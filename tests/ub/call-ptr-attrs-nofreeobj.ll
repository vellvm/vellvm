; UB tests for the `nofreeobj` attribute.
;
; LangRef (nofreeobj): "On arguments, this indicates that the underlying object
; of the argument cannot be freed during the execution of the function. ...
; Unlike nofree, it is not possible to free the underlying object through a
; different pointer either."  "On return values, ... any free of the
; underlying object must happen-before the function returns, otherwise the
; behavior is undefined."
;
; NOTE: neither Vellvm's parser nor LLVM 23.1 accepts `nofreeobj` yet (it is
; newer than that release), so this file only runs once support lands.

declare ptr @malloc(i64)
declare void @free(ptr)

define void @nofreeobj_frees_other(ptr nofreeobj %p, ptr %q) {
  call void @free(ptr %q)                         ; <- UB @call_nofreeobj_frees_other
  ret void
}

define i32 @call_nofreeobj_frees_other() {
  %p = call ptr @malloc(i64 4)
  call void @nofreeobj_frees_other(ptr %p, ptr %p)
  ret i32 0
}

; ASSERT UB 17: call i32 @call_nofreeobj_frees_other()

define nofreeobj ptr @ret_nofreeobj() {
  %p = call ptr @malloc(i64 4)
  ret ptr %p
}

define i32 @free_nofreeobj_return() {
  %p = call ptr @ret_nofreeobj()
  call void @free(ptr %p)                         ; <- UB @free_nofreeobj_return
  ret i32 0
}

; ASSERT UB 36: call i32 @free_nofreeobj_return()


