; UB tests for the `indirectbr` instruction.
;
; LangRef (indirectbr, Semantics): "All possible destination blocks must be
; listed in the label list, otherwise this instruction has undefined behavior.
; This implies that jumps to labels defined in other functions have undefined
; behavior as well.  If 'address' is poison or undef, this instruction has
; undefined behavior."

define i32 @indirectbr_poison() {
entry:
  indirectbr ptr poison, [ label %a, label %b ]   ; <- UB @indirectbr_poison
a:
  ret i32 1
b:
  ret i32 2
}

; ASSERT UB 11: call i32 @indirectbr_poison()

define i32 @indirectbr_undef() {
entry:
  indirectbr ptr undef, [ label %a, label %b ]    ; <- UB @indirectbr_undef
a:
  ret i32 1
b:
  ret i32 2
}

; ASSERT UB 22: call i32 @indirectbr_undef()

; A null address is not the address of any listed block.
define i32 @indirectbr_null() {
entry:
  indirectbr ptr null, [ label %a, label %b ]     ; <- UB @indirectbr_null
a:
  ret i32 1
b:
  ret i32 2
}

; ASSERT UB 34: call i32 @indirectbr_null()

; Control: a block address that is listed is jumped to.
define i32 @indirectbr_listed(i1 %c) {
entry:
  %t = select i1 %c, ptr blockaddress(@indirectbr_listed, %a), ptr blockaddress(@indirectbr_listed, %b)
  indirectbr ptr %t, [ label %a, label %b ]
a:
  ret i32 1
b:
  ret i32 2
}

; ASSERT EQ: i32 1 = call i32 @indirectbr_listed(i1 1)
; ASSERT EQ: i32 2 = call i32 @indirectbr_listed(i1 0)

; Control: the address may go through ptrtoint and back.
define i32 @indirectbr_roundtrip() {
entry:
  %i = ptrtoint ptr blockaddress(@indirectbr_roundtrip, %b) to i64
  %t = inttoptr i64 %i to ptr
  indirectbr ptr %t, [ label %a, label %b ]
a:
  ret i32 1
b:
  ret i32 2
}

; ASSERT EQ: i32 2 = call i32 @indirectbr_roundtrip()

; A block of this function that is not in the label list.
define i32 @indirectbr_not_listed() {
entry:
  indirectbr ptr blockaddress(@indirectbr_not_listed, %c), [ label %a, label %b ] ; <- UB @indirectbr_not_listed
a:
  ret i32 1
b:
  ret i32 2
c:
  ret i32 3
}

; ASSERT UB 74: call i32 @indirectbr_not_listed()

; A block of another function, with the same name as a listed one.
define i32 @indirectbr_other_function() {
entry:
  indirectbr ptr blockaddress(@indirectbr_listed, %a), [ label %a ] ; <- UB @indirectbr_other_function
a:
  ret i32 1
}

; ASSERT UB 88: call i32 @indirectbr_other_function()

