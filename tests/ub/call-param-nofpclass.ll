; UB tests for the `nofpclass` parameter attribute on `call`.
;
; LangRef (nofpclass(<test mask>)): "If the value is a floating-point class
; indicated by the nofpclass test mask, a poison value is passed or returned
; instead."  Combined with `noundef` (LangRef noundef: "If the value
; representation contains any undefined or poison bits, the behavior is
; undefined") the violation is immediate UB.
;
; The classes (LangRef llvm.is.fpclass) are snan, qnan, ninf, nnorm, nsub,
; nzero, pzero, psub, pnorm, pinf, and the unions nan, inf, norm, sub, zero.

define i32 @take_nonan_noundef(double noundef nofpclass(nan) %x) {
  ret i32 0
}

define i32 @nofpclass_noundef_nan() {
  %nan = fdiv double 0.0, 0.0
  %r = call i32 @take_nonan_noundef(double %nan)  ; <- UB @nofpclass_noundef_nan
  ret i32 %r
}

; ASSERT UB 18: call i32 @nofpclass_noundef_nan()

define i32 @take_nozero_noundef(double noundef nofpclass(zero) %x) {
  ret i32 0
}

define i32 @nofpclass_noundef_negzero() {
  %r = call i32 @take_nozero_noundef(double -0.0) ; <- UB @nofpclass_noundef_negzero
  ret i32 %r
}

; ASSERT UB 29: call i32 @nofpclass_noundef_negzero()

define i32 @nofpclass_noundef_ok() {
  %r = call i32 @take_nonan_noundef(double 1.0)
  ret i32 %r
}

; ASSERT EQ: i32 0 = call i32 @nofpclass_noundef_ok()

; nofpclass without noundef: poison.
define double @nonan_observe(double nofpclass(nan) %x) {
  ret double %x
}

define double @nofpclass_only_nan() {
  %nan = fdiv double 0.0, 0.0
  %r = call double @nonan_observe(double %nan)
  ret double %r
}

; ASSERT EQ: double poison = call double @nofpclass_only_nan()

; float as well as double: inf.
define i32 @take_float_noinf_noundef(float noundef nofpclass(inf) %x) {
  ret i32 0
}

define i32 @nofpclass_float_inf() {
  %r = call i32 @take_float_noinf_noundef(float 0x7FF0000000000000) ; <- UB @nofpclass_float_inf
  ret i32 %r
}

; ASSERT UB 61: call i32 @nofpclass_float_inf()

; A subnormal (the smallest positive double) is in class sub.
define i32 @take_nosub_noundef(double noundef nofpclass(sub) %x) {
  ret i32 0
}

define i32 @nofpclass_subnormal() {
  %r = call i32 @take_nosub_noundef(double 0x0000000000000001) ; <- UB @nofpclass_subnormal
  ret i32 %r
}

; ASSERT UB 73: call i32 @nofpclass_subnormal()

; 1.0 is in class norm, and not in nan or inf.
define i32 @take_nonorm_noundef(double noundef nofpclass(norm) %x) {
  ret i32 0
}

define i32 @nofpclass_normal() {
  %r = call i32 @take_nonorm_noundef(double 1.0)  ; <- UB @nofpclass_normal
  ret i32 %r
}

; ASSERT UB 85: call i32 @nofpclass_normal()

define i32 @take_nonan_noinf_noundef(double noundef nofpclass(nan inf) %x) {
  ret i32 0
}

define i32 @nofpclass_normal_ok() {
  %r = call i32 @take_nonan_noinf_noundef(double 1.0)
  ret i32 %r
}

; ASSERT EQ: i32 0 = call i32 @nofpclass_normal_ok()

; Excluding only signaling NaNs allows a quiet one (0.0/0.0 is quiet).
define i32 @take_nosnan_noundef(double noundef nofpclass(snan) %x) {
  ret i32 0
}

define i32 @nofpclass_snan_quiet_ok() {
  %nan = fdiv double 0.0, 0.0
  %r = call i32 @take_nosnan_noundef(double %nan)
  ret i32 %r
}

; ASSERT EQ: i32 0 = call i32 @nofpclass_snan_quiet_ok()

; Vectors are checked lane by lane: without noundef, only the NaN lane
; becomes poison.
define double @vec_lane(<2 x double> nofpclass(nan) %v, i32 %k) {
  %e = extractelement <2 x double> %v, i32 %k
  ret double %e
}

define double @nofpclass_vector_lane(i32 %k) {
  %nan = fdiv double 0.0, 0.0
  %v0 = insertelement <2 x double> poison, double 2.0, i32 0
  %v = insertelement <2 x double> %v0, double %nan, i32 1
  %r = call double @vec_lane(<2 x double> %v, i32 %k)
  ret double %r
}

; ASSERT EQ: double 2.0 = call double @nofpclass_vector_lane(i32 0)
; ASSERT EQ: double poison = call double @nofpclass_vector_lane(i32 1)

; On the return value: with noundef, returning an excluded class is UB at the
; callee's ret.
define noundef nofpclass(nan) double @ret_nan() {
  %nan = fdiv double 0.0, 0.0
  ret double %nan                                 ; <- UB @call_ret_nan
}

define i32 @call_ret_nan() {
  %r = call double @ret_nan()
  ret i32 0
}

