; UB tests for the `udiv` instruction.
;
; LangRef (udiv, Semantics): "Division by zero is undefined behavior. For
; vectors, if any element of the divisor is zero, the operation has undefined
; behavior."
; LangRef (Poison Values): immediate UB occurs if poison is used as "the divisor
; operand of a udiv, sdiv, urem or srem instruction".
; UndefinedBehavior.md: "`udiv %x, undef` is UB since we replace undef with 0".

define i32 @udiv(i32 %a, i32 %b) {
  %r = udiv i32 %a, %b                            ; <- UB @udiv
  ret i32 %r
}

; ASSERT UB 11: call i32 @udiv(i32 7, i32 0)
; ASSERT UB 11: call i32 @udiv(i32 7, i32 poison)
; Controls: a nonzero divisor is fine, and a poison *dividend* is only poison.
; ASSERT EQ: i32 3 = call i32 @udiv(i32 7, i32 2)
; ASSERT EQ: i32 poison = call i32 @udiv(i32 poison, i32 2)

define i32 @udiv_undef_divisor() {
  %r = udiv i32 7, undef                          ; <- UB @udiv_undef_divisor
  ret i32 %r
}

; ASSERT UB 22: call i32 @udiv_undef_divisor()

; A divisor that is zero only after freeze is a concrete zero: still UB.
define i32 @udiv_freeze_zero() {
  %z = freeze i32 0
  %r = udiv i32 7, %z                             ; <- UB @udiv_freeze_zero
  ret i32 %r
}

; ASSERT UB 31: call i32 @udiv_freeze_zero()

; Vector: one zero lane makes the whole operation UB.
define <2 x i32> @udiv_vec_zero_lane() {
  %r = udiv <2 x i32> <i32 8, i32 8>, <i32 2, i32 0> ; <- UB @udiv_vec_zero_lane
  ret <2 x i32> %r
}

; ASSERT UB 39: call <2 x i32> @udiv_vec_zero_lane()

; Vector: one poison lane in the divisor is UB.
define <2 x i32> @udiv_vec_poison_lane() {
  %r = udiv <2 x i32> <i32 8, i32 8>, <i32 2, i32 poison> ; <- UB @udiv_vec_poison_lane
  ret <2 x i32> %r
}

; ASSERT UB 47: call <2 x i32> @udiv_vec_poison_lane()

; `exact` violations produce poison, not UB.
define i32 @udiv_exact(i32 %a, i32 %b) {
  %r = udiv exact i32 %a, %b
  ret i32 %r
}

; ASSERT EQ: i32 poison = call i32 @udiv_exact(i32 7, i32 2)

; ---- both operands poison
; A poison divisor is UB whatever the dividend is, so poison/poison is UB too,
; not poison.  (Vellvm used to test the poison dividend first, returning
; poison for udiv/urem and failing with "ill_typed-iop: sdiv/srem" for
; sdiv/srem.)

define i32 @udiv_pp() {
  %r = udiv i32 poison, poison                    ; <- UB @udiv_pp
  ret i32 %r
}

; ASSERT UB 68: call i32 @udiv_pp()
; ASSERT UB 11: call i32 @udiv(i32 poison, i32 poison)

; `exact` makes an inexact result poison; it does not excuse a poison divisor.
define i32 @udiv_exact_pp() {
  %r = udiv exact i32 poison, poison              ; <- UB @udiv_exact_pp
  ret i32 %r
}

; ASSERT UB 77: call i32 @udiv_exact_pp()

; Vellvm denotes undef as poison, so undef / undef is UB here.  (llubi reads
; each undef as "any value", picks a nonzero divisor, and reports no UB.)
define i32 @udiv_uu() {
  %r = udiv i32 undef, undef                      ; <- UB @udiv_uu
  ret i32 %r
}

; ASSERT UB 86: call i32 @udiv_uu()

; x / x where x is poison from an nsw overflow.
define i32 @udiv_self(i32 %a) {
  %p = add nsw i32 %a, 1
  %r = udiv i32 %p, %p                            ; <- UB @udiv_self
  ret i32 %r
}

; ASSERT UB 95: call i32 @udiv_self(i32 2147483647)
; ASSERT EQ: i32 1 = call i32 @udiv_self(i32 5)

; The all-poison vector constant (the scalar DVALUE_Poison in Vellvm).
define <2 x i32> @udiv_vec_pp() {
  %r = udiv <2 x i32> poison, poison              ; <- UB @udiv_vec_pp
  ret <2 x i32> %r
}

; ASSERT UB 104: call <2 x i32> @udiv_vec_pp()

; Controls: with both operands poison, every non-division integer operator
; gives poison, not UB (an oversized or poison shift amount is poison).
define i32 @nondiv_pp() {
  %a = add i32 poison, poison
  %b = sub i32 %a, poison
  %c = mul i32 %b, poison
  %d = shl i32 %c, poison
  %e = lshr i32 %d, poison
  %f = ashr i32 %e, poison
  %g = and i32 %f, poison
  %h = or i32 %g, poison
  %i = xor i32 %h, poison
  ret i32 %i
}

; ASSERT EQ: i32 poison = call i32 @nondiv_pp()

; Control: a poison quotient (poison dividend) is only poison; freezing and
; masking it gives a defined 0.
define i32 @udiv_freeze_poison_quotient() {
  %q = udiv i32 poison, 3
  %f = freeze i32 %q
  %r = and i32 %f, 0
  ret i32 %r
}

; ASSERT EQ: i32 0 = call i32 @udiv_freeze_poison_quotient()

