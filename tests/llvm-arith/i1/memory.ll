; i1 in memory: sizes and offsets, load/store through allocas and globals,
; i1 fields and elements, and i1 as a getelementptr / vector index.
;
; - an i1 occupies one byte; [N x i1] is N bytes, but <N x i1> is packed into
;   ceil(N/8) bytes, element 0 in the least significant bit (little endian).
; - a getelementptr index is *signed*, so an `i1 true` index steps back one
;   element; an extractelement/insertelement index is *unsigned*, so there
;   `i1 true` is element 1.
;
; Only i1 values that were stored as i1 are loaded as i1: the LangRef leaves
; the other seven bits of the byte unspecified.
;
;   clang -w tests/llvm-arith/i1/memory.ll -o a.out && ./a.out
;
; Generated by tests/llvm-arith/i1/gen-i1.py -- edit the generator, not this file.

@g_true   = global i1 true
@g_false  = global i1 false
@g_m1     = global i1 -1
@g_const  = constant i1 true
@g_mut    = global i1 true
@g_arr    = global [4 x i1] [i1 1, i1 0, i1 1, i1 1]
@g_struct = global { i1, i32, i1 } { i1 true, i32 7, i1 true }
@g_zero   = global [3 x i1] zeroinitializer
@g_bytes  = global [3 x i8] c"\0A\14\1E"

%s  = type { i1, i32, i1 }
%ps = type <{ i1, i32, i1 }>
%s3 = type { i1, i1, i1 }

