@fmt_switch_1 = private unnamed_addr constant [19 x i8] c"switch_1() = %lld\0A\00"
@fmt_switch_default_1 = private unnamed_addr constant [27 x i8] c"switch_default_1() = %lld\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
  %v0 = call i64 @switch_0()
  %p0 = call i32 (ptr, ...) @printf(ptr @fmt_switch_0, i64 %v0)
  %v1 = call i64 @switch_default_0()
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt_switch_default_0, i64 %v1)
  %v2 = call i64 @switch_1()
  %p2 = call i32 (ptr, ...) @printf(ptr @fmt_switch_1, i64 %v2)
